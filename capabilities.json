{
  "privileges": [],
  "sorting": {
    "default": {}
  },
  "dataRoles": [
    {
      "displayName": "Location / Facility",
      "name": "location",
      "kind": "Grouping"
    },
    {
      "displayName": "Provider Name",
      "name": "provider",
      "kind": "Grouping"
    },
    {
      "displayName": "Schedule Event Category",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Shift Start (Date/Time)",
      "name": "startDate",
      "kind": "Grouping"
    },
    {
      "displayName": "Shift End (Date/Time)",
      "name": "endDate",
      "kind": "Grouping"
    },
    {
      "displayName": "Case Count",
      "name": "caseCount",
      "kind": "Measure"
    },
    {
      "displayName": "Additional Metric (e.g. Units/Hours)",
      "name": "extraMetric",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            { "bind": { "to": "location" } },
            { "bind": { "to": "provider" } },
            { "bind": { "to": "category" } },
            { "bind": { "to": "startDate" } },
            { "bind": { "to": "endDate" } }
          ]
        },
        "values": {
          "select": [
            { "bind": { "to": "caseCount" } },
            { "bind": { "to": "extraMetric" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "colorPaletteSettings": {
      "displayName": "Colors & Themes",
      "properties": {
        "palette": {
          "displayName": "Color Palette",
          "type": {
            "enumeration": [
              { "value": "powerBi", "displayName": "Power BI Report Theme" },
              { "value": "tableau10", "displayName": "Tableau 10" },
              { "value": "category10", "displayName": "Category 10" },
              { "value": "paired", "displayName": "Paired" },
              { "value": "accent", "displayName": "Accent" },
              { "value": "dark2", "displayName": "Dark 2" },
              { "value": "set2", "displayName": "Set 2" }
            ]
          }
        }
      }
    },
    "legendSettings": {
      "displayName": "Legend",
      "properties": {
        "show": {
          "displayName": "Show Legend",
          "type": { "bool": true }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": [
              { "value": "Top", "displayName": "Top" },
              { "value": "Bottom", "displayName": "Bottom" },
              { "value": "Left", "displayName": "Left" },
              { "value": "Right", "displayName": "Right" }
            ]
          }
        },
        "fontSize": {
          "displayName": "Text Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontColor": {
          "displayName": "Text Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "swimlaneSettings": {
      "displayName": "Swimlanes & Rows",
      "properties": {
        "rowHeight": {
          "displayName": "Row Height (px)",
          "type": { "numeric": true }
        },
        "barHeightPercent": {
          "displayName": "Bar Thickness (%)",
          "type": { "numeric": true }
        },
        "providerColumnWidth": {
          "displayName": "Provider Column Width (px)",
          "type": { "numeric": true }
        },
        "providerFontSize": {
          "displayName": "Provider Font Size",
          "type": { "formatting": { "fontSize": true } }
