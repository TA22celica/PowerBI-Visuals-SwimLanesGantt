        "providerSort": {
          "displayName": "Provider Order",
          "type": {
            "enumeration": [
              { "value": "natural", "displayName": "Data Model Order" },
              { "value": "asc", "displayName": "Alphabetical (A-Z)" },
              { "value": "desc", "displayName": "Alphabetical (Z-A)" },
