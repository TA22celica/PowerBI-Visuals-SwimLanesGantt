{
  "privileges": [],
  "sorting": {
    "default": {}
  },
  "dataRoles": [
    {
      "displayName": "Group / Swimlane (e.g. Facility, Project)",
      "name": "group",
      "kind": "Grouping"
    },
    {
      "displayName": "Item / Resource (e.g. Provider, Machine, Task)",
      "name": "item",
      "kind": "Grouping"
    },
    {
      "displayName": "Category / Status (e.g. Shift Type, Phase)",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Start Date / Time",
      "name": "startDate",
      "kind": "Grouping"
    },
    {
      "displayName": "End Date / Time",
      "name": "endDate",
      "kind": "Grouping"
    },
    {
      "displayName": "Primary Metric / Count (e.g. Cases, Output)",
      "name": "primaryMetric",
      "kind": "Measure"
    },
    {
      "displayName": "Secondary Metric (e.g. Units, Hours, Cost)",
      "name": "secondaryMetric",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "categorical": {
        "categories": {
          "select": [
            { "bind": { "to": "group" } },
            { "bind": { "to": "item" } },
            { "bind": { "to": "category" } },
            { "bind": { "to": "startDate" } },
            { "bind": { "to": "endDate" } }
          ]
        },
        "values": {
          "select": [
            { "bind": { "to": "primaryMetric" } },
            { "bind": { "to": "secondaryMetric" } }
          ]
        }
      }
    }
  ],
  "objects": {
    "colorPaletteSettings": {
      "displayName": "Colors & Themes",
      "properties": {
        "palette": {
          "displayName": "Theme Palette",
          "type": {
            "enumeration": [
              { "value": "powerBi", "displayName": "Power BI Theme" },
              { "value": "tableau10", "displayName": "Tableau 10" },
              { "value": "category10", "displayName": "Category 10" },
              { "value": "paired", "displayName": "Paired" },
              { "value": "accent", "displayName": "Accent" },
              { "value": "dark2", "displayName": "Dark 2" },
              { "value": "set2", "displayName": "Set 2" }
            ]
          }
        }
      }
    },
    "legendSettings": {
      "displayName": "Legend",
      "properties": {
        "show": {
          "displayName": "Show Legend",
          "type": { "bool": true }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": [
              { "value": "Top", "displayName": "Top" },
              { "value": "Bottom", "displayName": "Bottom" },
              { "value": "Left", "displayName": "Left" },
              { "value": "Right", "displayName": "Right" }
            ]
          }
        },
        "fontSize": {
          "displayName": "Text Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontColor": {
          "displayName": "Text Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "swimlaneSettings": {
      "displayName": "Swimlanes & Layout",
      "properties": {
        "rowHeight": {
          "displayName": "Row Height (px)",
          "type": { "numeric": true }
        },
        "barHeightPercent": {
          "displayName": "Bar Thickness (%)",
          "type": { "numeric": true }
        },
        "resourceColumnWidth": {
          "displayName": "Resource Column Width (px)",
          "type": { "numeric": true }
        },
        "resourceFontSize": {
          "displayName": "Resource Font Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "resourceFontColor": {
          "displayName": "Resource Font Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "showZebraStriping": {
          "displayName": "Alternating Row Fills",
          "type": { "bool": true }
        },
        "evenRowColor": {
          "displayName": "Even Row Background",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "oddRowColor": {
          "displayName": "Odd Row Background",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "showRowBorders": {
          "displayName": "Show Row Dividers",
          "type": { "bool": true }
        },
        "rowBorderColor": {
          "displayName": "Divider Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "groupHeaderSettings": {
      "displayName": "Group Headers",
      "properties": {
        "showHeader": {
          "displayName": "Show Group Header",
          "type": { "bool": true }
        },
        "headerHeight": {
          "displayName": "Header Height (px)",
          "type": { "numeric": true }
        },
        "headerFontSize": {
          "displayName": "Header Font Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "headerFontColor": {
          "displayName": "Header Font Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "headerBgColor": {
          "displayName": "Header Background Fill",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "showMetricBadge": {
          "displayName": "Show Group Total Badge",
          "type": { "bool": true }
        },
        "badgeBgColor": {
          "displayName": "Badge Background Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "badgeTextColor": {
          "displayName": "Badge Text Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "barSettings": {
      "displayName": "Gantt Bars & Concurrency",
      "properties": {
        "barOpacity": {
          "displayName": "Bar Opacity (%)",
          "type": { "numeric": true }
        },
        "barCornerRadius": {
          "displayName": "Corner Radius (px)",
          "type": { "numeric": true }
        },
        "showBorder": {
          "displayName": "Show Bar Border",
          "type": { "bool": true }
        },
        "borderColor": {
          "displayName": "Border Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "borderWidth": {
          "displayName": "Border Width (px)",
          "type": { "numeric": true }
        },
        "showMetricNotches": {
          "displayName": "Show Micro Metric Ticks",
          "type": { "bool": true }
        },
        "overlapMode": {
          "displayName": "Concurrent Overlap Mode",
          "type": {
            "enumeration": [
              { "value": "stagger", "displayName": "Stagger Vertically (Sub-rows)" },
              { "value": "overlay", "displayName": "Overlay Translucent" }
            ]
          }
        }
      }
    },
    "labelSettings": {
      "displayName": "Data Labels & Badges",
      "properties": {
        "show": {
          "displayName": "Show Data Labels",
          "type": { "bool": true }
        },
        "labelPosition": {
          "displayName": "Position",
          "type": {
            "enumeration": [
              { "value": "pillBadge", "displayName": "Floating Pill Badge" },
              { "value": "insideCenter", "displayName": "Centered Text Inside Bar" },
              { "value": "right", "displayName": "Trailing (End of Bar)" },
              { "value": "above", "displayName": "Above Bar" }
            ]
          }
        },
        "labelContent": {
          "displayName": "Label Content",
          "type": {
            "enumeration": [
              { "value": "metricOnly", "displayName": "Primary Metric Only" },
              { "value": "metricAndDuration", "displayName": "Metric + Duration" },
              { "value": "durationOnly", "displayName": "Duration Only" }
            ]
          }
        },
        "fontSize": {
          "displayName": "Font Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontColor": {
          "displayName": "Font Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "badgeBgColor": {
          "displayName": "Pill Badge Fill Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "prefix": {
          "displayName": "Prefix",
          "type": {
            "enumeration": [
              { "value": "none", "displayName": "None" },
              { "value": "Count: ", "displayName": "Count: " },
              { "value": "Qty: ", "displayName": "Qty: " },
              { "value": "#", "displayName": "#" }
            ]
          }
        },
        "suffix": {
          "displayName": "Suffix",
          "type": {
            "enumeration": [
              { "value": "none", "displayName": "None" },
              { "value": " cases", "displayName": " cases" },
              { "value": " units", "displayName": " units" },
              { "value": " tasks", "displayName": " tasks" }
            ]
          }
        }
      }
    },
    "timeAxisSettings": {
      "displayName": "Timeline & Window Clamping",
      "properties": {
        "timeFormat": {
          "displayName": "Time Axis Format",
          "type": {
            "enumeration": [
              { "value": "auto", "displayName": "Adaptive Auto" },
              { "value": "12hour", "displayName": "12-Hour (e.g. 7:00 AM)" },
              { "value": "24hour", "displayName": "24-Hour (e.g. 07:00)" },
              { "value": "dateTimeShort", "displayName": "Date + Time (Oct 13, 07:00)" }
            ]
          }
        },
        "clampToDailyWindow": {
          "displayName": "Clamp to Daily Window",
          "type": { "bool": true }
        },
        "dayStartHour": {
          "displayName": "Day Start Hour (0-23)",
          "type": { "numeric": true }
        },
        "dayEndHour": {
          "displayName": "Day End Hour (1-24)",
          "type": { "numeric": true }
        },
        "fontSize": {
          "displayName": "Font Size",
          "type": { "formatting": { "fontSize": true } }
        },
        "fontColor": {
          "displayName": "Font Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "showGridlines": {
          "displayName": "Show Vertical Gridlines",
          "type": { "bool": true }
        },
        "gridlineColor": {
          "displayName": "Gridline Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "referenceLineSettings": {
      "displayName": "Reference Lines & Markers",
      "properties": {
        "showNowLine": {
          "displayName": "Show 'Current Time' Indicator",
          "type": { "bool": true }
        },
        "nowLineColor": {
          "displayName": "Current Time Color",
          "type": { "fill": { "solid": { "color": true } } }
        },
        "showMilestoneLines": {
          "displayName": "Show Interval Markers (07:00/15:00/19:00)",
          "type": { "bool": true }
        },
        "milestoneLineColor": {
          "displayName": "Interval Marker Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "thresholdAlertSettings": {
      "displayName": "Duration & Threshold Alerts",
      "properties": {
        "highlightLongIntervals": {
          "displayName": "Flag Extended Durations",
          "type": { "bool": true }
        },
        "thresholdHours": {
          "displayName": "Duration Threshold (Hours)",
