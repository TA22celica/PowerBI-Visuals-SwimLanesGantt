              { "value": "asc", "displayName": "Alphabetical (A-Z)" },
              { "value": "desc", "displayName": "Alphabetical (Z-A)" },
              { "value": "caseDesc", "displayName": "Highest Total Cases First" },
              { "value": "caseAsc", "displayName": "Lowest Total Cases First" }
            ]
