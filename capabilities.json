        },
        "warningBorderColor": {
          "displayName": "Alert Border Color",
          "type": { "fill": { "solid": { "color": true } } }
        }
      }
    },
    "sortSettings": {
      "displayName": "Sorting & Order",
      "properties": {
        "groupSort": {
          "displayName": "Group Order",
          "type": {
            "enumeration": [
              { "value": "natural", "displayName": "Data Model Order" },
              { "value": "asc", "displayName": "Alphabetical (A-Z)" },
              { "value": "desc", "displayName": "Alphabetical (Z-A)" },
              { "value": "metricDesc", "displayName": "Highest Total Metric First" },
              { "value": "metricAsc", "displayName": "Lowest Total Metric First" }
            ]
          }
        },
        "resourceSort": {
          "displayName": "Resource / Item Order",
          "type": {
            "enumeration": [
              { "value": "natural", "displayName": "Data Model Order" },
              { "value": "asc", "displayName": "Alphabetical (A-Z)" },
              { "value": "desc", "displayName": "Alphabetical (Z-A)" },
              { "value": "metricDesc", "displayName": "Highest Metric First" },
              { "value": "metricAsc", "displayName": "Lowest Metric First" },
              { "value": "startAsc", "displayName": "Earliest Start First" }
            ]
          }
        }
      }
